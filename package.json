{
  "name": "pos-limpieza",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema Punto de Venta (POS) a Medida - Tienda de Productos de Limpieza",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,UI -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src-server/index.ts",
    "dev:client": "vite",
    "server": "tsx src-server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx src-server/index.ts",
    "preview": "vite preview",
    "test": "tsx --test tests/pos.test.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "pdfkit": "^0.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^22.15.21",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
